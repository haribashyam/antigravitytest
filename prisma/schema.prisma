// FuelWise Production Database Schema
// Compatible with SQLite (local development) and PostgreSQL (Neon / Supabase / AWS RDS)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id               String       @id @default(uuid())
  email            String       @unique
  name             String
  passwordHash     String
  unitSystem       String       @default("metric") // "metric" | "imperial"
  currency         String       @default("INR")    // "INR" | "USD" | "EUR" | "GBP"
  fuelPriceSource  String       @default("manual") // "manual" | "api"
  defaultFuelPrice Float        @default(102.50)   // Price per litre
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  sessions         Session[]
  vehicles         Vehicle[]
  tripLogs         TripLog[]

  @@map("users")
}

model Session {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([token])
  @@map("sessions")
}

model Vehicle {
  id             String           @id @default(uuid())
  userId         String
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  name           String           // Display name e.g. "Honda City ZX"
  make           String
  model          String
  year           Int
  fuelType       String           @default("petrol") // "petrol" | "diesel" | "cng" | "hybrid" | "electric"
  m0             Float            // Base ideal mileage in km/L
  ratedPayloadKg Float            @default(450.0)    // Rated payload in kg
  notes          String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  tripLogs        TripLog[]
  coefficientSets CoefficientSet[]

  @@index([userId])
  @@map("vehicles")
}

model TripLog {
  id                  String   @id @default(uuid())
  vehicleId           String
  vehicle             Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  userId              String
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tripName            String   // e.g. "Expressway Commute"
  origin              String?
  destination         String?
  distanceKm          Float    // Distance in km
  fuelUsedLitres      Float    // Actual fuel consumed in Litres
  predictedFuelLitres Float?   // Model predicted fuel in Litres
  avgSpeedKmh         Float    // Average speed in km/h
  trafficIntensity    Float    @default(0.0) // 0.0 to 1.0
  loadRatio           Float    @default(0.0) // 0.0 to 1.0 of rated payload
  hardAccelEvents     Int      @default(0)
  hardBrakeEvents     Int      @default(0)
  aggressiveFactor    Float    @default(0.0) // events / km
  gradientDecimal     Float    @default(0.0) // e.g. 0.015 for 1.5%
  idleMinutes         Float    @default(0.0) // minutes spent idling
  fuelPricePerLitre   Float    // Price per litre at trip time
  actualCost          Float    // fuelUsedLitres * fuelPricePerLitre
  predictedCost       Float?   // predictedFuelLitres * fuelPricePerLitre
  dataSource          String   @default("manual") // "manual" | "gps_live" | "api_routed"
  notes               String?
  date                DateTime @default(now())
  createdAt           DateTime @default(now())

  @@index([vehicleId])
  @@index([userId])
  @@index([date])
  @@map("trip_logs")
}

model CoefficientSet {
  id         String   @id @default(uuid())
  vehicleId  String
  vehicle    Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  version    Int      @default(1)
  kv         Float    // Speed squared factor
  kt         Float    // Traffic intensity factor
  kl         Float    // Load factor
  ka         Float    // Aggressive driving factor
  kg         Float    // Road gradient factor
  ki         Float    // Idle fuel consumption factor
  isDefault  Boolean  @default(true) // true if population engineering baseline
  sampleSize Int      @default(0)    // number of trips used to fit
  rSquared   Float?   // R² on test hold-out set
  mae        Float?   // Mean Absolute Error on test set
  mape       Float?   // Mean Absolute Percentage Error on test set
  notes      String?
  createdAt  DateTime @default(now())

  @@index([vehicleId])
  @@map("coefficient_sets")
}
