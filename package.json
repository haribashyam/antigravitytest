{
  "name": "fuelwise-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev || ./node_modules/.bin/next dev",
    "build": "(prisma generate || ./node_modules/.bin/prisma generate) && (next build || ./node_modules/.bin/next build)",
    "start": "next start || ./node_modules/.bin/next start",
    "lint": "eslint . || ./node_modules/.bin/eslint .",
    "postinstall": "prisma generate || ./node_modules/.bin/prisma generate || true",
    "test": "vitest run || ./node_modules/.bin/vitest run",
    "db:push": "prisma db push || ./node_modules/.bin/prisma db push",
    "db:seed": "tsx prisma/seed.ts || ./node_modules/.bin/tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "lucide-react": "^1.49.0",
    "ml-matrix": "^6.15.0",
    "next": "16.3.8",
    "ogl": "^1.0.11",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "recharts": "^3.10.1",
    "simple-statistics": "^7.12.1",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "prisma": "^6.19.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^4.1.11"
  }
}
