# FuelWise Environment Configuration Example
# Copy to .env.local or .env

# Local SQLite database (zero-configuration, persistent relational SQL database)
DATABASE_URL="file:./dev.db"

# For PostgreSQL (Neon / Supabase / AWS RDS / Docker Postgres):
# DATABASE_URL="postgresql://user:password@localhost:5432/fuelwise?schema=public"

# Session Secret (used for signing session tokens)
SESSION_SECRET="fuelwise-super-secret-auth-key-change-in-production-2026"

# Optional External API Keys (Fully functional fallbacks with transparent badges if unconfigured)
# 1. Mapbox Directions API (Optional: fallback to free OpenStreetMap OSRM routing)
# MAPBOX_ACCESS_TOKEN=""

# 2. Google Maps Platform API (Optional: Distance Matrix, Elevation API)
# GOOGLE_MAPS_API_KEY=""

# 3. TomTom Traffic API (Optional: fallback to documented 4-level scale)
# TOMTOM_API_KEY=""

# 4. Open-Elevation API (Optional: defaults to public open-elevation endpoint)
# OPEN_ELEVATION_API_URL="https://api.open-elevation.com/api/v1/lookup"
